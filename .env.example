# Copy to `.env.local` (never commit real secrets).

# Auth + OpenAI (Phase 4 / Phase 6)
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
OPENAI_API_KEY=

# Dev/CI only — put in `.dev.vars` for Playwright e2e. Never set on production Worker.
# When "true", POST /api/trips/[tripId]/itinerary returns a fixture stream and still persists.
# E2E_ITINERARY_FIXTURE=true

# Optional — Drizzle Kit against remote D1 (`driver: "d1-http"`); see `drizzle.config.ts`
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_DATABASE_ID=
# CLOUDFLARE_API_TOKEN=
