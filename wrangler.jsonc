{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tripsprint-ai",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-06-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "tripsprint-ai"
		}
	],
	"vars": {
		"AUTH_URL": "https://tripsprint-ai.agnieszkakot22.workers.dev",
		"AUTH_TRUST_HOST": "true",
		"EMAIL_FROM": "noreply@tripsprint-ai.agnieszkakot22.workers.dev"
	},
	// Cloudflare Email Sending. The sending domain must be onboarded once via
	// `npx wrangler email sending enable <domain>`. Absent in local dev — see
	// src/lib/email.ts for the console fallback.
	"send_email": [{ "name": "EMAIL" }],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "tripsprint-ai-db",
			"database_id": "4b2e40e5-fa8e-477a-a90c-3b942490e279",
			"migrations_dir": "./drizzle"
		}
	]
}
